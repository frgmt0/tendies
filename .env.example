# Discord bot token (required to run the bot)
DISCORD_TOKEN=your-bot-token-here

# Database URL. Production: Postgres via asyncpg.
#   postgresql+asyncpg://user:password@localhost:5432/tendies
# Leave the default to use a local SQLite file (handy for solo testing).
DATABASE_URL=sqlite+aiosqlite:///tendies.db

# Command prefix (default "$")
COMMAND_PREFIX=$

# Name of the role that grants Manager (central-bank) powers.
MANAGER_ROLE=Tendies Manager

# Real seconds between game-day ticks. 86400 = one real day per game day.
# Set low (e.g. 60) to speed up the economy for testing.
TICK_INTERVAL_SECONDS=86400
