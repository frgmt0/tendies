# Use a separate Discord application for development.
DISCORD_TOKEN=your-development-bot-token
DATABASE_URL=sqlite+aiosqlite:///tendies-dev.db
COMMAND_PREFIX=$
MANAGER_ROLE=Tendies Manager

# Production default: actual host calendar, local midnight with DST.
GAME_TIME_MODE=calendar
# Optional IANA override; omit to follow the host server timezone.
# GAME_TIMEZONE=America/Los_Angeles

# Used ONLY when GAME_TIME_MODE=accelerated (development/tests).
TICK_INTERVAL_SECONDS=60
GITHUB_REPOSITORY=frgmt0/tendies
