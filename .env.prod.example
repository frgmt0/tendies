# Copy to .env.prod (ignored by Git), chmod 600, and supply your production token.
# deployer transfers this via SSH to a private environment file outside releases.
DISCORD_TOKEN=your-production-bot-token
GAME_TIME_MODE=calendar
GITHUB_REPOSITORY=frgmt0/tendies
# DATABASE_URL and TENDIES_HEALTH_FILE come from deploy.toml.
# Leave GAME_TIMEZONE unset to match desktop's configured timezone and DST.
